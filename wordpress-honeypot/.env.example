# Copy to .env and fill in before running install.sh
DOMAIN=honeypot.example.com
SITE_TITLE="Summit Business Solutions"
WP_ADMIN_EMAIL=security-team@example.com

# Where honeypot logs are written
HONEYPOT_LOG_DIR=/var/log/wp-honeypot

# Optional: webhook (Slack/Discord/generic JSON POST) for real-time alerts.
# Leave blank to disable webhook delivery (events are still logged locally).
ALERT_WEBHOOK_URL=

# CIDR allowed to reach SSH (22). Narrow this to your admin network/VPN.
ALLOWED_SSH_CIDR=0.0.0.0/0
